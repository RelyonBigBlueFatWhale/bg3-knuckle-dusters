# Normalise line endings so Windows checkouts do not produce CRLF noise
* text=auto eol=lf

# Binary assets must never be converted
*.png binary
*.jpg binary
*.webp binary
*.DDS binary
*.obj text eol=crlf
*.pak binary

# Larian data files are XML/LSX; keep them as-is (the game writes tabs)
*.lsx text eol=lf
*.loca binary